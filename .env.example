DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# 64 hex characters (32 bytes). Losing it makes stored state unreadable.
TF_MASTER_KEY=
TF_ADDR=127.0.0.1:8080
TF_ENGINE=fake
TF_COOKIE_SECURE=0
TF_REQUIRE_VERIFIED=0
TF_BASE_URL=http://127.0.0.1:8080

# Requests per second one caller may make to /api/ (0 turns the limit off)
TF_API_RATE=30

# How long a lock taken through the API / by the OpenTofu CLI lasts unless renewed (0: no expiry)
TF_API_LOCK_LEASE_SECS=3600
TF_CLI_LOCK_LEASE_SECS=43200
