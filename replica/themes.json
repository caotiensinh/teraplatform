{
  "_about": "Themes for the infrastructure-run-platform category (HCP Terraform / OpenTofu and their alternatives). Patterns are case-insensitive regular expressions matched against each review's text. A review can match several themes. Written for this project from the gap list in gaps.md plus the usual complaint words of the category; the default consumer-app themes matched unrelated text (for example AWS 'permissions').",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bshould (be able to|support|allow)\\b"
  ],
  "themes": [
    {"id": "pricing_rum", "label": "Price, and paying per resource under management", "kind": "complaint",
     "patterns": ["resources? under management", "\\bRUM\\b", "per[- ]resource", "pricing (change|model|tier)", "price (increase|hike)", "too expensive", "\\bexpensive\\b", "overpriced", "\\bper[- ](user|seat)\\b", "free tier", "not worth (the|it)", "paid (tier|plan)"]},
    {"id": "license_lockin", "label": "Licence change and vendor lock-in", "kind": "complaint",
     "patterns": ["\\bBSL\\b", "business source licen[cs]e", "re-?licen[cs]", "licen[cs]e change", "rug.?pull", "vendor lock", "\block-in\b", "\blocked.in\b", "\\bfork\\b", "open.?source (licen|project)"]},
    {"id": "slow_plan", "label": "Slow plan, refresh and apply", "kind": "complaint",
     "patterns": ["plan (is |was |takes? |being )?(very |really |so )?slow", "slow (plan|refresh|apply|init)", "takes? (forever|ages|minutes|hours)", "refresh.{0,40}(slow|forever|minutes)", "times? ?out", "large state", "thousands of resources"]},
    {"id": "stuck_lock_queue", "label": "Stuck locks and run queues", "kind": "complaint",
     "patterns": ["state lock(ed|ing)?\b.{0,60}(stuck|error|acquir|held|release)", "error acquiring the state lock", "lock(ed)? (the )?(state|workspace)", "force.?unlock", "stuck (in |on )?(a )?(run|queue|plan|apply|pending|planning|applying|lock)", "(run|plan|apply) (is |was )?stuck", "run queue", "queued (run|plan)", "waiting for (a )?(run|lock)", "pending (run|queue)", "concurrent (run|apply)", "lock (is )?(held|stuck)"]},
    {"id": "unknown_values", "label": "Values unknown at plan time (for_each, count)", "kind": "complaint",
     "patterns": ["known after apply", "unknown (at plan|value)", "invalid (for_each|count)", "for_each.{0,60}(unknown|known|apply)", "count.{0,40}(unknown|known)", "cannot be determined until apply", "can'?t be (known|determined)"]},
    {"id": "secrets_state", "label": "Secrets and credentials in state or on disk", "kind": "complaint",
     "patterns": ["plain.?text", "secrets? (in|inside|end up in) (the )?(state|plan)", "sensitive (values?|data).{0,40}(state|plan|log)", "credentials.{0,40}(state|disk|log)", "leak(s|ed|ing)?\\b"]},
    {"id": "drift", "label": "Drift between code and reality", "kind": "complaint",
     "patterns": ["\\bdrift"]},
    {"id": "errors_debug", "label": "Hard-to-read errors and debugging", "kind": "complaint",
     "patterns": ["(error|message)s? (is|are|was|were)? ?(not helpful|unhelpful|cryptic|confusing|unclear|useless)", "cryptic", "hard to debug", "impossible to debug", "unhelpful error", "no (clear|useful) (error|message)"]},
    {"id": "reliability", "label": "Outages and unreliable service", "kind": "complaint",
     "patterns": ["outage", "downtime", "status page", "service (was )?(down|unavailable|degraded)", "unreliable", "flaky", "degraded performance", "\\b5\\d\\d (error|response)"]},
    {"id": "providers_size", "label": "Provider downloads, cache and cold starts", "kind": "complaint",
     "patterns": ["provider.{0,40}(download|too big|huge|\\d+ ?(mb|gb))", "plugin cache", "cold start", "\\.terraform.{0,40}(gb|mb|size|huge)", "init (is |takes? )?(slow|forever|long)"]},
    {"id": "hcl_limits", "label": "HCL limits (loops, conditions, templating)", "kind": "complaint",
     "patterns": ["\\bHCL\\b.{0,60}(limit|awkward|verbose|painful|clunky|ugly)", "(no|lacks?|missing) (real )?(loops|conditionals|functions)", "templating", "turing", "dsl (is|was)"]},
    {"id": "support_docs", "label": "Support and documentation", "kind": "complaint",
     "patterns": ["support (ticket|team|never|didn'?t|is useless)", "(?<!_)no response(?!_)", "documentation (is|was)? ?(poor|bad|lacking|outdated|confusing)", "docs? (are|is) (poor|bad|outdated|confusing)"]},
    {"id": "alternatives", "label": "Moving to an alternative", "kind": "request",
     "patterns": ["\\b(switch(ed|ing)?|migrat(e|ed|ing|ion)|moved?|moving) (to|from|away from)\\b.{0,40}(opentofu|tofu|spacelift|env0|atlantis|scalr|pulumi|crossplane|terragrunt)", "alternative to (terraform|hcp|tfc)", "instead of terraform (cloud|enterprise)"]},
    {"id": "policy_lint", "label": "Policy, linting and cost checks in the run", "kind": "request",
     "patterns": ["\\btflint\\b", "\\blint(er|ing)?\\b", "\\bOPA\\b", "\\bsentinel\\b", "policy.as.code", "\\bcheckov\\b", "\\bconftest\\b", "\\binfracost\\b", "\\btrivy\\b|\\btfsec\\b", "cost estimat"]},
    {"id": "teams_access", "label": "Teams, permissions and workspace organisation", "kind": "request",
     "patterns": ["\\bprojects?\\b.{0,40}(workspace|permission)", "team (permission|access|token)", "\\bRBAC\\b", "role.based", "variable sets?", "workspace (tags?|sprawl|organi[sz]ation)", "many workspaces", "least privilege"]},
    {"id": "vcs_pr_flow", "label": "Pull-request and VCS workflow", "kind": "request",
     "patterns": ["pull request", "\\bPR (comment|plan|workflow)", "\\batlantis\\b", "\\bgitops\\b", "speculative plan", "\\bwebhook"]},
    {"id": "self_host", "label": "Self-hosting and agents", "kind": "request",
     "patterns": ["self.?host", "on.?prem", "\\bagents?\\b.{0,30}(run|pool|private)", "air.?gapped", "private network", "\\bterraform enterprise\\b"]},
    {"id": "state_mgmt", "label": "State storage, rollback and encryption", "kind": "request",
     "patterns": ["state (rollback|history|version|encryption|backup|migration|surgery)", "remote state", "state (file )?(is )?(corrupt|lost)", "\\bstate (mv|rm)\\b", "encrypt(ed|ion)? (the )?state"]}
  ]
}
